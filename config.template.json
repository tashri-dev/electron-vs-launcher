{
    "rootPath": "",
    "solutions": [
        {
            "name": "Example Solution",
            "path": "ExamplePath\\Solution.sln",
            "type": "dotnet",
            "migratorPath": "ExamplePath\\Migrator\\Migrator.csproj",
            "dockerPort": 5001,
            "contextFolder": "ExamplePath",
            "imageContainerName": "example-solution",
            "startupProject": "ExamplePath\\API\\ExampleAPI.csproj",
            "args": "--environment Development --urls http://localhost:5000"
        },
        {
            "name": "Example Angular App",
            "path": "ExamplePath\\AngularApp",
            "type": "angular",
            "args": "--ssl --ssl-cert src/portal.crt --ssl-key src/portal.key"
        },
        {
            "name": "Example Custom Command",
            "path": "ExamplePath\\CustomApp",
            "type": "nodejs",
            "startup": "npm run dev -- --port 3000 --host 0.0.0.0"
        }
    ]
}