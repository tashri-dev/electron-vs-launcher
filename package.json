      "icon": "./assets/favicon.ico"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "bootstrap": "^5.3.2",
    "electron-notification": "^1.0.0",
    "font-awesome": "^4.7.0",
    "glob": "^10.3.10",
    "winreg": "^1.2.5"
  }
}
